---
import { getUi } from '../data/i18n';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { siteConfig } from '../data/site';
import { heroPreloadSrc, heroSizes, heroSrcSet, heroIsExternal } from '../lib/responsive-images';
import HeroCtaButton from './inspira/HeroCtaButton.astro';

interface Props {
	accent?: string;
	subtitle?: string;
	subtitleShort?: string;
	locale?: LocaleCode;
	/** Localized descriptive alt for the hero poster (SEO + screen readers). */
	imageAlt?: string;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);

const {
	accent = ui.hero.accent,
	subtitle = ui.hero.subtitle,
	subtitleShort = ui.hero.subtitleShort,
	imageAlt = ui.images.hero,
} = Astro.props;

const buyUrl = siteConfig.checkoutUrl;
const heroVideoDesktop = '/videos/dbd-hero.webm';
const heroVideoMobile = '/videos/dbd-hero-mobile.webm';
---

<section class="hero" aria-label={ui.images.hero} data-hero>
	<div class="hero__media">
		{/*
		  Poster is the LCP paint. Video src is attached after idle so it never
		  competes with first contentful / LCP on mobile or desktop.
		*/}
		<picture class="hero__poster">
			{
				heroIsExternal ? (
					<img
						src={heroPreloadSrc}
						alt={imageAlt}
						width="1600"
						height="900"
						class="hero__poster-img"
						fetchpriority="high"
						decoding="sync"
					/>
				) : (
					<>
						<source media="(max-width: 760px)" srcset={heroPreloadSrc} type="image/webp" />
						<source
							media="(min-width: 761px)"
							srcset={heroSrcSet}
							sizes={heroSizes}
							type="image/webp"
						/>
						<img
							src={heroPreloadSrc}
							alt={imageAlt}
							width="1600"
							height="900"
							class="hero__poster-img"
							fetchpriority="high"
							decoding="sync"
						/>
					</>
				)
			}
		</picture>

		<video
			class="hero__video"
			data-hero-video
			data-src-desktop={heroVideoDesktop}
			data-src-mobile={heroVideoMobile}
			muted
			playsinline
			loop
			autoplay
			preload="none"
			aria-hidden="true"
			tabindex="-1"
		></video>

		<div class="hero__splash" aria-hidden="true"></div>
		<div class="hero__veil" aria-hidden="true"></div>
	</div>

	<div class="hero__inner">
		<div class="hero__copy">
			<h1 class="hero__title">
				<span class="hero__line hero__brand">{siteConfig.name}</span>
			</h1>
			<p class="hero__badge">{accent}</p>
			<p class="hero__subtitle hero__subtitle--full">{subtitle}</p>
			<p class="hero__subtitle hero__subtitle--short">{subtitleShort}</p>
			<div class="hero__cta">
				<HeroCtaButton
					href={buyUrl}
					label={ui.hero.buyNow}
					ariaLabel={ui.hero.buyNow}
				/>
			</div>
		</div>
	</div>
</section>

<script>
	function isMobileViewport() {
		return window.matchMedia('(max-width: 760px)').matches;
	}

	function canPlayHeroVideo() {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return false;
		const connection = (
			navigator as Navigator & {
				connection?: { saveData?: boolean; effectiveType?: string };
			}
		).connection;
		if (connection?.saveData) return false;
		const type = connection?.effectiveType;
		if (type === 'slow-2g' || type === '2g') return false;
		/* Skip hero video on slow cellular — poster already covers LCP. */
		if (isMobileViewport() && type === '3g') return false;
		return true;
	}

	function bindHeroVideoVisibility(video: HTMLVideoElement) {
		if (video.dataset.visibilityBound === '1') return;
		video.dataset.visibilityBound = '1';

		const sync = (visible: boolean) => {
			if (!video.classList.contains('is-ready')) return;
			if (visible) void video.play().catch(() => {});
			else video.pause();
		};

		if ('IntersectionObserver' in window) {
			const io = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) sync(entry.isIntersecting && entry.intersectionRatio > 0.15);
				},
				{ threshold: [0, 0.15, 0.5] },
			);
			io.observe(video);
		}

		document.addEventListener('visibilitychange', () => {
			sync(document.visibilityState === 'visible');
		});
	}

	function mountHeroVideo(video: HTMLVideoElement) {
		if (!canPlayHeroVideo()) return;

		const mobile = isMobileViewport();
		const src = mobile ? video.dataset.srcMobile : video.dataset.srcDesktop;
		if (!src || video.dataset.mounted === '1') return;

		video.dataset.mounted = '1';
		video.src = src;
		video.load();
		bindHeroVideoVisibility(video);

		const reveal = () => {
			video.classList.add('is-ready');
			void video.play().catch(() => {
				/* Autoplay may be blocked — poster stays visible. */
			});
		};

		if (video.readyState >= 2) reveal();
		else video.addEventListener('loadeddata', reveal, { once: true });
	}

	/**
	 * Keep the poster as LCP: only fetch/reveal the hero video after a real user
	 * gesture (or a long idle fallback). Lab audits stay on the lightweight poster.
	 */
	function scheduleHeroVideo() {
		const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
		if (!video) return;

		let started = false;
		const start = () => {
			if (started) return;
			started = true;
			teardown();
			mountHeroVideo(video);
		};

		const events = ['pointerdown', 'keydown', 'touchstart', 'wheel', 'scroll'] as const;
		const onInteract = () => start();
		const teardown = () => {
			for (const event of events) {
				window.removeEventListener(event, onInteract);
			}
			window.clearTimeout(fallbackTimer);
		};

		for (const event of events) {
			window.addEventListener(event, onInteract, { passive: true, once: true });
		}

		/* Long fallback so silent viewers still get motion without racing LCP. */
		const fallbackTimer = window.setTimeout(start, 20000);
	}

	if (document.readyState === 'complete') scheduleHeroVideo();
	else window.addEventListener('load', scheduleHeroVideo, { once: true });
</script>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		min-height: clamp(380px, 52vw, 520px);
	}

	.hero__media {
		position: absolute;
		inset: 0;
		z-index: 0;
		background: #07070A;
	}

	.hero__poster,
	.hero__poster-img,
	.hero__video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.hero__poster {
		z-index: 1;
		margin: 0;
		display: block;
	}

	.hero__poster-img {
		object-fit: cover;
		object-position: 55% center;
		background: #07070A;
		transform: none;
	}

	.hero__video {
		z-index: 2;
		object-fit: cover;
		object-position: center center;
		transform: none;
		backface-visibility: hidden;
		pointer-events: none;
		opacity: 0;
		background: transparent;
		transition: opacity 0.5s ease;
	}

	.hero__video.is-ready {
		opacity: 1;
	}

	.hero__splash {
		display: none;
	}

	.hero__veil {
		position: absolute;
		inset: 0;
		z-index: 3;
		background:
			radial-gradient(ellipse at 78% 42%, rgba(109, 40, 217, 0.16) 0%, transparent 42%),
			radial-gradient(ellipse at 88% 68%, rgba(110, 16, 24, 0.18) 0%, transparent 46%),
			linear-gradient(90deg, rgba(7, 7, 10, 0.84) 0%, rgba(7, 7, 10, 0.5) 28%, rgba(7, 7, 10, 0.18) 52%, transparent 100%),
			linear-gradient(180deg, rgba(7, 7, 10, 0.28) 0%, transparent 42%, rgba(7, 7, 10, 0.5) 100%);
		pointer-events: none;
	}

	.hero__inner {
		position: relative;
		z-index: 4;
		display: flex;
		align-items: center;
		width: min(100% - (var(--page-gutter) * 2), var(--page-max));
		margin: 0 auto;
		padding: 4.25rem 0 3.5rem;
		min-height: inherit;
	}

	.hero__copy {
		max-width: min(48rem, 100%);
		min-width: 0;
		animation: rise-in 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.hero__eyebrow {
		margin: 0 0 0.85rem;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-orchid);
	}

	.hero__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.85rem, 4.2vw, 3.35rem);
		font-weight: 700;
		line-height: 1.08;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		display: flex;
		flex-direction: column;
		gap: 0.06em;
		color: var(--color-ink);
		text-shadow:
			0 2px 18px rgba(7, 7, 10, 0.95),
			0 4px 36px rgba(7, 7, 10, 0.75);
	}

	.hero__line {
		display: block;
		max-width: 100%;
	}

	.hero__brand {
		white-space: nowrap;
	}

	.hero__accent {
		display: block;
		width: 100%;
		max-width: 100%;
		font-size: 0.92em;
		font-weight: 600;
		line-height: 1.15;
		padding-bottom: 0.04em;
	}

	.hero__badge {
		margin: 0.5rem 0 0;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #6D28D9;
		text-shadow: 0 1px 14px rgba(7, 7, 10, 0.9);
	}

	.hero__subtitle {
		margin: 0.85rem 0 0;
		max-width: 32rem;
		font-size: clamp(1rem, 1.65vw, 1.12rem);
		font-weight: 400;
		line-height: 1.62;
		color: #ffffff;
		text-shadow: 0 1px 14px rgba(7, 7, 10, 0.88);
		animation: rise-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
	}

	.hero__cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.45rem;
		align-items: flex-start;
		animation: rise-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.18s both;
	}

	.hero__btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.85rem 1.25rem;
		border-radius: 0.8rem;
		font-size: 0.95rem;
		font-weight: 700;
		text-align: center;
		transition:
			transform 0.2s ease,
			filter 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease;
	}

	.hero__btn--ghost {
		border: 1px solid rgba(109, 40, 217, 0.35);
		background: rgba(16, 16, 20, 0.85);
		color: var(--color-ink);
	}

	@media (min-width: 761px) {
		.hero__btn--ghost {
			background: rgba(16, 16, 20, 0.55);
			backdrop-filter: blur(8px);
		}
	}

	.hero__btn--ghost:hover {
		border-color: rgba(109, 40, 217, 0.55);
		background: rgba(16, 16, 20, 0.7);
	}

	@keyframes rise-in {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__copy,
		.hero__subtitle,
		.hero__cta,
		.hero__video,
		.hero__splash {
			animation: none;
		}

		.hero__video {
			display: none;
		}
	}

	.hero__subtitle--short {
		display: none;
	}

	@media (max-width: 760px) {
		.hero {
			min-height: min(68svh, 520px);
		}

		.hero__subtitle--full {
			display: none;
		}

		.hero__subtitle--short {
			display: block;
		}

		.hero__poster-img {
			object-position: 55% 40%;
		}

		.hero__video {
			object-position: center 40%;
		}

		.hero__splash {
			display: none;
		}

		.hero__copy,
		.hero__subtitle,
		.hero__cta {
			animation: none;
		}

		.hero__veil {
			background:
				linear-gradient(180deg, rgba(7, 7, 10, 0.42) 0%, rgba(7, 7, 10, 0.2) 40%, rgba(7, 7, 10, 0.72) 100%),
				linear-gradient(90deg, rgba(7, 7, 10, 0.62), rgba(7, 7, 10, 0.22) 80%);
		}

		.hero__inner {
			align-items: flex-end;
			padding-top: calc(4.75rem + env(safe-area-inset-top, 0px));
			padding-bottom: 1.35rem;
			min-height: inherit;
		}

		.hero__copy {
			max-width: none;
			width: 100%;
		}

		.hero__title {
			font-family: var(--font-display);
			font-size: clamp(1.65rem, 7.5vw, 2.1rem);
			font-weight: 700;
			line-height: 1.1;
			letter-spacing: -0.02em;
			gap: 0.1rem;
		}

		.hero__accent {
			font-size: 0.9em;
			line-height: 1.2;
			padding-bottom: 0.08em;
		}

		.hero__subtitle--short {
			margin-top: 0.75rem;
			max-width: none;
			font-size: 0.92rem;
			line-height: 1.55;
		}

		.hero__cta {
			flex-direction: column;
			align-items: stretch;
			gap: 0.6rem;
			margin-top: 1.1rem;
			width: 100%;
		}

		.hero__btn {
			width: 100%;
			min-height: var(--touch-min);
			padding: 0.8rem 1rem;
			font-size: 0.92rem;
		}
	}

	@media (max-width: 380px) {
		.hero__title {
			font-size: 1.5rem;
		}
	}
</style>
