---
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { featureSectionImages } from '../data/dbd';
import { productFeatureCategories, productFeatureDetails } from '../data/site';
import FeatureCarousel from './FeatureCarousel.astro';
import RelatedPages from './RelatedPages.astro';
import { contentSrc, contentSrcSet, productMainSizes } from '../lib/responsive-images';

interface Props {
	locale?: LocaleCode;
	showFullLink?: boolean;
	showRelatedPages?: boolean;
	compactHeading?: boolean;
}

const locale = Astro.props.locale ?? defaultLocale;
const showFullLink = Astro.props.showFullLink ?? true;
const showRelatedPages = Astro.props.showRelatedPages ?? true;
const compactHeading = Astro.props.compactHeading ?? false;
const ui = getUi(locale);
const featuresHref = getLocalizedPath('features', locale);
const sectionTitle = compactHeading ? 'Included in every license' : ui.nav.features;

const detailByTitle = Object.fromEntries(
	productFeatureDetails.map((section) => [section.title.toLowerCase(), section]),
);

const slides = productFeatureCategories.map((category, index) => {
	const detail =
		detailByTitle[category.title.toLowerCase()] ??
		productFeatureDetails[Math.min(index, productFeatureDetails.length - 1)];
	const shot = featureSectionImages[detail.id as keyof typeof featureSectionImages];
	return {
		title: category.title,
		summary: detail.summary,
		items: category.items,
		imageSrc: contentSrc(shot.src),
		imageSrcSet: contentSrcSet(shot.src),
		imageSizes: productMainSizes,
		imageAlt: shot.alt,
	};
});
---

<div class="pricing-features">
	<FeatureCarousel
		title={sectionTitle}
		subtitle="One license. Combat assist, ESP, and radar — nothing gated behind add-ons."
		slides={slides}
	/>

	{
		showFullLink && (
			<a href={featuresHref} class="pricing-features__link">
				See full feature breakdown
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
				</svg>
			</a>
		)
	}

	{showRelatedPages && <RelatedPages locale={locale} />}
</div>

<style>
	.pricing-features {
		display: grid;
		gap: 1.15rem;
		width: 100%;
	}

	.pricing-features__link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		justify-self: center;
		padding: 0.55rem 0.2rem;
		color: var(--color-orchid);
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.pricing-features__link:hover {
		color: var(--color-bright);
	}
</style>
